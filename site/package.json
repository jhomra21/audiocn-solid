{
  "name": "@audiocn-solid/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run search:index && vite",
    "build": "bun run ../tools/registry/build.ts && bun run search:index && bun run scripts/build-contributors.ts && bun run scripts/build-github-stars.ts && vite build && bun run scripts/build-seo.ts && if [ \"$AUDIOCN_RELEASE\" = \"1\" ]; then bun run scripts/check-release-routes.ts; fi",
    "build:release": "bun run build && bun run scripts/check-release-routes.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test lib",
    "test:e2e": "playwright test",
    "test:routes": "playwright test e2e/routes.spec.ts",
    "parity": "playwright test e2e/parity/parity.spec.ts",
    "spike:1": "bun run scripts/spike-1.ts",
    "spike:2": "bun run scripts/spike-2.ts",
    "search:index": "bun run scripts/build-search-index.ts",
    "og:build": "bun run scripts/build-social-images.ts",
    "spike:5": "bun run scripts/spike-5.ts"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.13",
    "filesystem-routing": "0.4.0",
    "ogl": "^1.0.11",
    "solid-js": "2.0.0-rc.13"
  },
  "devDependencies": {
    "@fumadocs/tailwind": "0.1.2",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.63.0",
    "@shikijs/rehype": "4.5.0",
    "@solidjs/prerender": "0.2.0",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "lightningcss": "1.32.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "mdast-util-to-markdown": "2.2.0",
    "prerender-crawler": "0.2.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "remark-toc": "9.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "5.0.0",
    "vite": "^8.0.0"
  }
}

@@ -0,0 +1,138 @@
+// A touch is owned until completion, not until an unrelated document click.
+export function makeTouchOutside(ownerDoc, isOutside, captureGuard) {
+  let pending;
+  const clear = () => {
+    if (!pending) return;
+    for (const [type, listener] of pending.listeners)
+      ownerDoc.removeEventListener(type, listener, true);
+    for (const timer of pending.timers) clearTimeout(timer);
+    pending = undefined;
+  };
+  const start = (down, dispatch) => {
+    if (pending) {
+      const completed = pending.up;
+      clear();
+      if (!completed) return;
+    }
+    if (!down.isPrimary || !isOutside(down)) return;
+    const guard = captureGuard?.() ?? (() => true);
+    if (!guard()) return;
+    const gesture = pending = {
+      up: undefined, touchStart: undefined, touchEnd: undefined,
+      click: undefined, listeners: [], timers: [], started: performance.now()
+    };
+    const moved = (point) =>
+      Math.hypot(point.clientX - down.clientX, point.clientY - down.clientY) > 10;
+    const listen = (type, listener) => {
+      gesture.listeners.push([type, listener]);
+      ownerDoc.addEventListener(type, listener, { capture: true, passive: true });
+    };
+    const later = (callback, delay) => {
+      gesture.timers.push(setTimeout(callback, delay));
+    };
+    const valid = () => {
+      if (pending !== gesture || !gesture.up) return false;
+      if (gesture.touchStart && !gesture.touchEnd) return false;
+      if ([down, gesture.up, gesture.touchStart, gesture.touchEnd, gesture.click]
+        .some((event) => event?.defaultPrevented)) {
+        clear();
+        return false;
+      }
+      const hit = ownerDoc.elementFromPoint(gesture.up.clientX, gesture.up.clientY);
+      if (!guard() || !isOutside(down) || !gesture.upTarget ||
+        !isOutside({ target: gesture.upTarget }) || !hit || !isOutside({ target: hit })) {
+        clear();
+        return false;
+      }
+      return true;
+    };
+    const finish = (fallback) => {
+      if (!valid()) return;
+      const original = down.target.closest("button, a[href], input, select, textarea, label") ?? down.target;
+      clear();
+      const accepted = dispatch();
+      if (fallback && accepted) {
+        // This consumed gesture, rather than the disposed layer, owns this
+        // bounded guard. Preserve activation of the original control and children.
+        const remove = () => {
+          clearTimeout(timer);
+          ownerDoc.removeEventListener("click", swallow, true);
+          ownerDoc.removeEventListener("pointerdown", remove, true);
+        };
+        const swallow = (event) => {
+          if (!event.detail || moved(event)) return;
+          const hit = ownerDoc.elementFromPoint(event.clientX, event.clientY);
+          if (event.target instanceof ownerDoc.defaultView.Element &&
+            hit && event.target.contains(hit) && !original.contains(hit) &&
+            !gesture.upTarget.contains(hit)) {
+            event.preventDefault();
+            event.stopImmediatePropagation();
+          }
+          remove();
+        };
+        const timer = setTimeout(remove, 400);
+        ownerDoc.addEventListener("click", swallow, true);
+        ownerDoc.addEventListener("pointerdown", remove, true);
+      }
+    };
+    const complete = () => {
+      // A task observes prevention by target/bubble listeners after dispatch.
+      // Upstream waits ~350ms for compatibility clicks to avoid click-through.
+      later(() => {
+        if (!valid()) return;
+        if (gesture.click) finish(false);
+        else later(() => finish(true), 400);
+      }, 0);
+    };
+    listen("pointerdown", clear);
+    listen("pointercancel", clear);
+    listen("touchcancel", clear);
+    listen("scroll", clear);
+    listen("pointermove", (event) => {
+      if (event.pointerId === down.pointerId && moved(event)) clear();
+    });
+    listen("touchstart", (event) => {
+      const touch = event.changedTouches[0];
+      if (gesture.touchStart || event.touches.length !== 1 || !touch ||
+        touch.target !== down.target || moved(touch)) {
+        clear();
+        return;
+      }
+      gesture.touchStart = event;
+      gesture.touchId = touch.identifier;
+    });
+    listen("touchmove", (event) => {
+      const touch = [...event.touches].find((touch) => touch.identifier === gesture.touchId);
+      if (event.touches.length !== 1 || !touch || moved(touch)) clear();
+    });
+    listen("pointerup", (event) => {
+      if (event.pointerId !== down.pointerId) return;
+      if (moved(event) || performance.now() - gesture.started >= 500) {
+        clear();
+        return;
+      }
+      gesture.up = event;
+      gesture.upTarget = ownerDoc.elementFromPoint(event.clientX, event.clientY);
+      if (!gesture.touchStart) complete();
+    });
+    listen("touchend", (event) => {
+      const touch = [...event.changedTouches].find((touch) => touch.identifier === gesture.touchId);
+      if (!gesture.up || !touch || event.touches.length || moved(touch)) {
+        clear();
+        return;
+      }
+      gesture.touchEnd = event;
+      complete();
+    });
+    listen("click", (event) => {
+      if (!event.detail || moved(event) || !gesture.up) return;
+      gesture.click = event;
+      later(() => finish(false), 0);
+    });
+    // Reject a held pointer before a context menu or a later unrelated click.
+    later(() => {
+      if (!gesture.up || gesture.touchStart && !gesture.touchEnd) clear();
+    }, 500);
+  };
+  return { start, clear };
+}

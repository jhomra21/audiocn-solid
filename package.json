{
  "name": "audiocn-solid",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "compare": "bun run tools/compare/run.ts",
    "parity": "cd site && bunx playwright test e2e/parity/parity.spec.ts",
    "check": "bun run typecheck && bun run build",
    "test:e2e": "bun run test:e2e:solid1",
    "test:e2e:solid1": "playwright test",
    "test:e2e:solid2": "playwright test --config playwright.solid2.config.ts",
    "site:spike:1": "cd site && bun run spike:1",
    "registry:build": "bun run tools/registry/build.ts",
    "registry:test-install": "bun run tools/registry/test-install.ts",
    "registry:spike:3": "bun run registry:build && bun run registry:test-install && bun run registry:test-fader && bun run registry:test-parameter-slider && bun run registry:test-knob && bun run registry:test-pan-control && bun run registry:test-channel-toggle && bun run registry:test-volume-control && bun run registry:test-channel-strip && bun run registry:test-mixer && bun run registry:test-use-mixer",
    "kobalte:spike:4": "bun run tools/spikes/kobalte/run.ts",
    "site:spike:5": "cd site && bun run spike:5",
    "registry:test-fader": "bun run tools/registry/test-fader.ts",
    "registry:test-parameter-slider": "bun run tools/registry/test-parameter-slider.ts",
    "registry:test-knob": "bun run tools/registry/test-knob.ts",
    "registry:test-pan-control": "bun run tools/registry/test-pan-control.ts",
    "registry:test-channel-toggle": "bun run tools/registry/test-channel-toggle.ts",
    "registry:test-volume-control": "bun run tools/registry/test-volume-control.ts",
    "registry:test-channel-strip": "bun run tools/registry/test-channel-strip.ts",
    "registry:test-mixer": "bun run tools/registry/test-mixer.ts",
    "registry:test-use-mixer": "bun run tools/registry/test-use-mixer.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "solid-js": "^1.9.15",
    "@kobalte/core-solid1": "npm:@kobalte/core@0.13.14",
    "@kobalte/core-solid2": "npm:@kobalte/core@2.0.0-alpha.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "oxlint": "1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.15 <3"
  },
  "workspaces": [
    "site"
  ]
}

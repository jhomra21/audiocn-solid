{
  "extends": "./tsconfig.library.json",
  "compilerOptions": {
    "jsxImportSource": "@solidjs/web",
    "paths": {
      "@kobalte/core/popover": [
        "./node_modules/@kobalte/core-solid2/dist/popover/index.d.ts"
      ],
      "@/lib/solid/jsx-types": ["./lib/solid/compat/solid2/jsx-types.ts"],
      "@/*": ["./*"],
      "@kobalte/core/slider": [
        "./node_modules/@kobalte/core-solid2/dist/slider/index.d.ts"
      ]
    }
  },
  "exclude": ["lib/solid/jsx-types.ts"]
}
